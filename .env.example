# ─── Resend (email backend) ───────────────────────────────────────────────────
# Get your free API key at https://resend.com
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_your_api_key_here

# The email address that receives client enquiries
# Create this in Resend → Domains after verifying blueblackbeige.in
CONTACT_TO_EMAIL=nayan@blueblackbeige.in

# The "from" address for auto-reply to clients
# Must match your verified Resend domain
CONTACT_FROM_EMAIL=hello@blueblackbeige.in

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# International format, no spaces or dashes (e.g. 919876543210 for India)
NEXT_PUBLIC_WHATSAPP_NUMBER=917667649211

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://blueblackbeige.in
